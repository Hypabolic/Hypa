<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>hypa-attach</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hypa.AttachHost</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    <SkipCopyMarkdownGrammar>true</SkipCopyMarkdownGrammar>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\Hypa.Cli\Attach\**\*.cs" />
    <Compile Include="..\Hypa.Cli\Mux\*.cs" />
    <Compile Include="..\Hypa.Cli\Commands\Work\*.cs" />
    <Compile Remove="..\Hypa.Cli\Commands\Work\WorkCommand.cs" />
    <Compile Include="..\Hypa.Runtime\Domain\Common\Result.cs" Link="Borrowed\Result.cs" />
    <Compile Include="..\Hypa.Runtime\Domain\Common\Unit.cs" Link="Borrowed\Unit.cs" />
    <EmbeddedResource Include="..\Hypa.Cli\Attach\Splash\hypa-logo.txt" LogicalName="Hypa.Cli.Attach.Splash.hypa-logo.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Hypa.Ttfx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hypa.Cube\Hypa.Cube.csproj" />
    <ProjectReference Include="..\Hypa.ControlPlane\Hypa.ControlPlane.csproj" />
    <ProjectReference Include="..\Hypa.AgentRuntime.Protocol\Hypa.AgentRuntime.Protocol.csproj" />
    <ProjectReference Include="..\Hypa.AgentRuntime\Hypa.AgentRuntime.csproj" />
    <ProjectReference Include="..\Hypa.Connectivity\Hypa.Connectivity.csproj" />
    <ProjectReference Include="..\Hypa.Continuity\Hypa.Continuity.csproj" />
    <ProjectReference Include="..\Hypa.Continuity.Harnesses\Hypa.Continuity.Harnesses.csproj" />
    <ProjectReference Include="..\Hypa.Placement\Hypa.Placement.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Hypa.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
