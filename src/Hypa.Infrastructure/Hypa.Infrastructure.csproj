<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Hypa.UnitTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Hypa.GoldenTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Override the native SQLite lib pulled transitively by Microsoft.Data.Sqlite
         (SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11) to the patched build, resolving
         GHSA-2m69-gcr7-jv3q / NU1903. The native lib tracks the SQLite version
         (3.50.3) while the managed SQLitePCLRaw packages stay on 2.1.x. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="TreeSitter.DotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hypa.Runtime\Hypa.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Skills\Resources\SKILL.md" />
    <EmbeddedResource Include="Skills\Resources\HYPA.md" />
    <!-- C# tree-sitter query pack (Slice 1). LogicalName keeps a stable AOT resource id. -->
    <EmbeddedResource Include="CodeIntelligence\Queries\c-sharp\tags.scm"
                      LogicalName="Hypa.Infrastructure.CodeIntelligence.Queries.c_sharp.tags.scm" />
    <!-- TypeScript/TSX tree-sitter query pack (Slice 4). Shared scm for both grammars. -->
    <EmbeddedResource Include="CodeIntelligence\Queries\typescript\tags.scm"
                      LogicalName="Hypa.Infrastructure.CodeIntelligence.Queries.typescript.tags.scm" />
    <EmbeddedResource Include="CodeIntelligence\Queries\NOTICE"
                      LogicalName="Hypa.Infrastructure.CodeIntelligence.Queries.NOTICE" />
  </ItemGroup>


</Project>
